{
  "name": "mira-workbench",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Mira's optional website collection and in-app browsing sub-application.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiraWorkspace/Mira-Workbench.git"
  },
  "homepage": "https://github.com/MiraWorkspace/Mira-Workbench#readme",
  "bugs": {
    "url": "https://github.com/MiraWorkspace/Mira-Workbench/issues"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "build:test": "vue-tsc --noEmit && vite build --mode test",
    "test": "node --test tests/*.test.mjs",
    "install:test": "npm run build:test && node scripts/install-local-test.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@mira/app-sdk": "github:MiraWorkspace/Mira-App-SDK#v0.4.0",
    "fflate": "^0.8.3",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  }
}
